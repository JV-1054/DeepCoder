{
  "upstream": "https://agentrouter.org",
  "port": 8899,
  "timeoutMs": 600000,
  "headers": {
    "originator": "pi"
  },
  "outputTokenFloors": {
    "gpt-6.1-sol": 16384
  },
  "stripParams": {
    "gpt-6.1-sol": ["temperature", "top_p", "frequency_penalty"]
  },
  "apiKeyEnv": "AGENTROUTER_API_KEY",
  "injectApiKey": true,
  "apiProtocol": "openai-responses",
  "dshProfile": "desktop",
  "models": [
    {
      "id": "gpt-6.1-sol",
      "name": "GPT-6.1-SOL",
      "contextWindow": 262144,
      "maxTokens": 16384,
      "input": ["text", "image"],
      "reasoningEfforts": {
        "off": "none",
        "minimal": "minimal",
        "low": "low",
        "medium": "medium",
        "high": "high",
        "xhigh": "xhigh",
        "max": "max"
      }
    }
  ]
}
